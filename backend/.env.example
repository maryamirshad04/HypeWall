# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# The "service_role" secret (NOT the anon key). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed once, for `npm run migrate:mongo` (copying old walls into Supabase)
MONGODB_URI=
